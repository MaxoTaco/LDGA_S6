    - target: {fileID: 4354066514307537563, guid: 395214123ce9bbe4496996030dd3dc26, type: 3}
      propertyPath: 'texts.Array.data[2]'
      value: "Mother: Doesn\u2019t it worry you that we\u2019re so close to the border?"
      objectReference: {fileID: 0}
    - target: {fileID: 4354066514307537563, guid: 395214123ce9bbe4496996030dd3dc26, type: 3}
      propertyPath: 'texts.Array.data[3]'
      value: "Father: It will be ok, don\u2019t worry. We\u2019ll be fine."
