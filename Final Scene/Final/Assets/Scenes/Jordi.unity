  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroScript
  introTexts:
  - 'Radio: Chulsoo, what is your location? We finished sweeping this part of the
    border. Over. '
  - "Chulsoo: Copy. This strange house is strange. It looks completely untouched.
    I\u2019m gonna take a look. Over."
  - 'Radio: What? Every house in this area is practically rubble. **Radio Static**
    Hurry up Chulsoo. Over.'
  - 'Chulsoo: Copy that. **Sound of Radio being put away**'
  - "Chulsoo: (Internal) Raidings, bombings, gun fights, yet this house is so clean?
    It doesn\u2019t make any sense\u2026"
  testSpeed: 0.05
  delayText: 1
  textEraseSpeed: 0.02
  blackScreenImage: {fileID: 1278866820}
  introAudio: {fileID: 0}
  player: {fileID: 1804492155}
  canvas: {fileID: 262728865}
