      objectReference: {fileID: 0}
    - target: {fileID: 5694422260402274442, guid: c6f8771ae8fc98b4ea82b7a491015223, type: 3}
      propertyPath: 'texts.Array.data[0]'
      value: "Mother: I don\u2019t feel safe here anymore. We need to leave now,
        Youngsoo!"
      objectReference: {fileID: 0}
    - target: {fileID: 5694422260402274442, guid: c6f8771ae8fc98b4ea82b7a491015223, type: 3}
      propertyPath: 'texts.Array.data[1]'
      value: "Father (plate shatters): Enough! We are not going anywhere! We don\u2019t
        have enough money to move everything. "
      objectReference: {fileID: 0}
    - target: {fileID: 5694422260402274442, guid: c6f8771ae8fc98b4ea82b7a491015223, type: 3}
      propertyPath: 'texts.Array.data[2]'
      value: 'Mother: What about Chulsoo? We have to find a way, for his sake!'
